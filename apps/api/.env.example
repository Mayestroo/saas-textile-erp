NODE_ENV=development
PORT=3000

MASTER_DB_HOST=localhost
MASTER_DB_PORT=5432
MASTER_DB_NAME=textile_master
MASTER_DB_USER=
MASTER_DB_PASSWORD=

# Dedicated database used only by Master DB integration tests. It must end in _test.
TEST_MASTER_DB_HOST=localhost
TEST_MASTER_DB_PORT=5432
TEST_MASTER_DB_NAME=textile_master_test
TEST_MASTER_DB_USER=
TEST_MASTER_DB_PASSWORD=

REDIS_HOST=localhost
REDIS_PORT=6379

# Generate independent random secrets (at least 32 bytes each); never reuse JWT keys between domains or token types.
PLATFORM_JWT_ACCESS_SECRET=
PLATFORM_JWT_REFRESH_SECRET=
TENANT_JWT_ACCESS_SECRET=
TENANT_JWT_REFRESH_SECRET=
# Keep this independent secret stable while rate-limit windows exist; rotation clears hashed bucket identities.
AUTH_LOGIN_BUCKET_HASH_SECRET=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900

TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432

# Dedicated elevated account. It requires CREATEDB, CREATEROLE, and authority to
# manage connection ACLs across this dedicated PostgreSQL application cluster.
TENANT_PROVISIONER_DB_HOST=localhost
TENANT_PROVISIONER_DB_PORT=5432
TENANT_PROVISIONER_DB_NAME=postgres
TENANT_PROVISIONER_DB_USER=
TENANT_PROVISIONER_DB_PASSWORD=

# Generate a private 32-byte key and encode it as unpadded base64url.
# Keep the same key (or retain the matching decryption key during rotation).
TENANT_CONNECTION_ENCRYPTION_KEY=

DEFAULT_TENANT_TIMEZONE=Asia/Tashkent

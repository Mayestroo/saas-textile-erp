{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && swc src --out-dir dist --config-file .swcrc --ignore \"**/*.spec.ts\" --strip-leading-paths --delete-dir-on-start",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npm run build && node dist/main.js",
    "start:dev": "npm run build && concurrently -k \"npm run watch:compile\" \"node --watch dist/main.js\"",
    "start:debug": "npm run build && concurrently -k \"npm run watch:compile\" \"node --inspect-brk --watch dist/main.js\"",
    "start:prod": "node dist/main.js",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:master:migrate": "npm run build && node dist/database/master/master-database.cli.js migrate",
    "db:master:revert": "npm run build && node dist/database/master/master-database.cli.js revert",
    "db:master:show": "npm run build && node dist/database/master/master-database.cli.js show",
    "db:master:seed": "npm run build && node dist/database/master/master-database.cli.js seed",
    "test:master-db": "vitest run src/database/master/master-database.integration.spec.ts",
    "test:tenant-provisioning": "vitest run src/database/tenant/tenant-provisioning.integration.spec.ts",
    "test:models-operations": "vitest run src/tenant/models/models-operations.integration.spec.ts",
    "test:workers-badges": "vitest run src/tenant/workers/workers-badges.integration.spec.ts",
    "watch:compile": "swc src --out-dir dist --config-file .swcrc --ignore \"**/*.spec.ts\" --strip-leading-paths --watch",
    "typecheck": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/typeorm": "^12.0.1",
    "@noble/ed25519": "^3.2.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@nestjs/schematics": "^12.0.5",
    "@nestjs/testing": "^12.1.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^5.0.2",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.2"
  }
}
